# ── Cockpit Frontend .env.example ──────────────────────────
# 复制为 .env 并填写与服务器 vLLM 一致的 API Key

LLM_API_KEY=请填写与服务器vLLM一致的API_Key
LLM_MODEL=memory-llm
LLM_BASE_URL=http://10.133.72.161:20140/v1
PROXY_PORT=8767

# ── 车机回答参数（前端对话，非记忆后端） ──
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=128
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
